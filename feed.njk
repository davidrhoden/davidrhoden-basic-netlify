---json
{
  "permalink": "feed.xml",
  "eleventyExcludeFromCollections": true,
  "metadata": {
    "title": "David Rhoden: Painter and Drawer. New Orleans, Louisiana.",
    "description": "New paintings, new drawings, occasional opinions. I post about my days. Thoughts on web development.",
    "language": "en",
    "base": "https://davidrhoden.com",
    "author": {
      "name": "David Rhoden"
    }
  }
}
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:atom="http://www.w3.org/2005/Atom" xml:base="{{ metadata.base }}">
  <channel>
    <title>{{ metadata.title }}</title>
    <link>{{ metadata.base }}</link>
    <atom:link href="https://davidrhoden.com/feed.xml" rel="self" type="application/rss+xml" />
    <description>{{ metadata.description }}</description>
    <language>{{ metadata.language or page.lang }}</language>
    <lastBuildDate>{{ collections.posts | getNewestCollectionItemDate | dateToRfc822 }}</lastBuildDate>
    {%- for post in collections.posts.slice(-30) | reverse %}
    {%- set absolutePostUrl %}{{ post.url | absoluteUrl(metadata.base) }}{% endset %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ absolutePostUrl }}</link>
      <description>{{ post.data.excerpt }}</description>
      <content:encoded><![CDATA[{{ post.templateContent | htmlToAbsoluteUrls(absolutePostUrl) | safe }}]]></content:encoded>
      <pubDate>{{ post.date | dateToRfc822 }}</pubDate>
      <dc:creator>{{ metadata.author.name }}</dc:creator>
      <guid>{{ absolutePostUrl }}</guid>
    </item>
    {%- endfor %}
  </channel>
</rss>
